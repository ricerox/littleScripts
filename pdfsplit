#!/usr/bin/env bash

#
# Split a PDF file into two at a page number
# Author: ricerox
# License: MIT
# Repo: https://github.com/ricerox/littleScripts/
#

if (( $# != 2 )) || [[ $* == *"--help"* ]]; then
    echo >&2 "Usage: $0 pdf pagenr"
    echo >&2 "pdfnr is the first page of the second part"
fi

pdf=${1}
pagenr=${2}

tmpDir=${ mktemp -d; }
trap 'rm -r "${tmpDir}"' EXIT

pdfseparate -l $(( pagenr - 1 )) "${pdf}" "${tmpDir}/first-%d.pdf"
pdfunite "${tmpDir}/first-"*.pdf "${pdf//.pdf/-1.pdf}"

pdfseparate -f $(( pagenr )) "${pdf}" "${tmpDir}/second-%d.pdf"
pdfunite "${tmpDir}/second-"*.pdf "${pdf//.pdf/-2.pdf}"

